module pack(w, h, copies) {
    gap = 4;
    function across(span, extent) = floor((span-8+gap)/(extent+gap));
    nx = across(bed_x,w);
    ny = across(bed_y,h);
    rx = across(bed_x,h);
    ry = across(bed_y,w);
    turn = rx*ry > nx*ny;
    cols = turn ? rx : nx;
    rows = turn ? ry : ny;
    assert(cols*rows>=copies, "Part or copy count exceeds this bed. Reduce copies or use a larger printer.");
    dx = (turn ? h : w) + gap;
    dy = (turn ? w : h) + gap;
    for (i=[0:copies-1])
        translate([((i%cols)-(min(copies,cols)-1)/2)*dx,
                   (floor(i/cols)-(ceil(copies/cols)-1)/2)*dy,0])
            rotate([0,0,turn ? 90 : 0]) children();
}

module mw_plate_1() {
    if(component=="cable-base") pack(132.0, 67.401, 1) accessory_0();
    if(component=="cable-lid") pack(143.801, 83.801, 1) accessory_1();
    if(component=="psu-base") pack(137.4, 230.7, 1) accessory_2();
    if(component=="psu-cover") pack(142.801, 241.878, 1) accessory_3();
    if(component=="siding-shim") pack(28.0, 60.0, small_part_copies) accessory_4();
    if(component=="flat-clip") pack(35.3, 18.0, small_part_copies) accessory_5();
    if(component=="round-clip") pack(26.0, 14.926, small_part_copies) accessory_6();
}
